# CampusAttend OS - Environment Configuration Example
# Copy this file to .env or .env.local in specific app directories as needed

# -----------------------------------------------------------------------------
# Supabase Backend Configuration
# -----------------------------------------------------------------------------
# Public API URL of your Supabase project (from Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key for client applications (safe to expose in client code with RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token

# Service Role Secret - REQUIRED ONLY for Edge Functions / DB Seeds / Backend Admin Scripts
# NEVER expose this key to client-side code (apps/college-web, apps/student-mobile, apps/smart-display)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret

# -----------------------------------------------------------------------------
# Dynamic QR Code Crypto Signing Secret
# -----------------------------------------------------------------------------
# Shared HMAC secret key used by Smart Displays and Edge Functions to sign and verify
# time-rotating QR codes to prevent screenshot sharing or proxy attendance.
QR_HMAC_SECRET_KEY=campusattend_enterprise_rotating_qr_secret_key_32bytes_min

# QR Code rotation interval in seconds (default: 15)
VITE_QR_ROTATION_SECONDS=15
EXPO_PUBLIC_QR_ROTATION_SECONDS=15

# Default Institution ID (optional convenience for multi-tenant setups)
VITE_DEFAULT_INSTITUTION_ID=00000000-0000-0000-0000-000000000001
EXPO_PUBLIC_DEFAULT_INSTITUTION_ID=00000000-0000-0000-0000-000000000001
